{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "declaration": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@figmapress/blueprint": ["packages/blueprint/src/index.ts"],
      "@figmapress/figma-parser": ["packages/figma-parser/src/index.ts"],
      "@figmapress/exporter": ["packages/exporter/src/index.ts"],
      "@figmapress/block-renderer": ["packages/block-renderer/src/index.ts"],
      "@figmapress/elementor-renderer": ["packages/elementor-renderer/src/index.ts"],
      "@figmapress/token-pipeline": ["packages/token-pipeline/src/index.ts"],
      "@figmapress/wp-connector": ["packages/wp-connector/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "examples/output", "apps/web", "**/dist"]
}
