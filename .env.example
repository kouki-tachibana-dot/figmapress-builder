# Figma (Priority B: real API connection — leave empty for mock workflow)
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=

# Figma OAuth for the public web app (all three are required to enable OAuth)
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
# Generate at least 32 random characters. Never commit the real value.
FIGMA_OAUTH_COOKIE_SECRET=
# Optional locally. Register the production callback in the Figma OAuth App:
# https://figmapress-builder.vercel.app/api/figma/oauth/callback
FIGMA_OAUTH_REDIRECT_URI=

# WordPress REST API (required for `npm run wp:create-draft`)
WORDPRESS_BASE_URL=https://example.com
WORDPRESS_USERNAME=admin
WORDPRESS_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
